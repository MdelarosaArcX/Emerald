PORT=4000
CORS_ORIGIN=http://localhost:5173

# Optional: local filesystem path to the Emerald backend's own Recordings folder. Only set this
# when Emerald and LiveEdit run on the same machine (e.g. the same value as Emerald's own
# EMERALD_RECORDINGS_PATH/default "Recordings" dir) — recorded video is then served straight off
# local disk instead of fetched over HTTP from the Emerald backend. Leave unset on a multi-machine
# LAN deployment; playback falls back to HTTP automatically either way.
# EMERALD_RECORDINGS_PATH=
