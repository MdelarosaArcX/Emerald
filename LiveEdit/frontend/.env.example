# Base URL of the main Emerald backend (the Deltacast capture/on-air server) — LiveEdit runs on
# its own machine and reaches across the LAN to it for live capture/on-air previews, it is NOT
# the same backend as LiveEdit's own (that one is VITE_DEV_BACKEND_URL below, via the Vite proxy).
# Copy this file to .env and point it at that server's actual LAN IP.
VITE_EMERALD_API_BASE_URL=http://10.0.0.32:5000

# Dev-server port and the LiveEdit backend the Vite proxy forwards /api, /proxies, /renders and
# /socket.io to. These are also vite.config.ts's defaults — set them here only to override.
VITE_DEV_PORT=5174
VITE_DEV_BACKEND_URL=http://localhost:5001
