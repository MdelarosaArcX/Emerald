EMERALD_URLS=http://127.0.0.1:5000
FRONTEND_ORIGIN=http://127.0.0.1:5173
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_QUEUE_NAME=emerald.jobs
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/emerald
EMERALD_RTMP_PORT=1935
EMERALD_RTMP_BIND=0.0.0.0
EMERALD_LOG_LEVEL=info
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
EMERALD_RECORDINGS_PATH=I:\EmeraldDeltacast\Emerald\backend\Recordings
EMERALD_BACKUP_PATH=E:\
# 0 (or blank) = unlimited. Otherwise a number + unit, e.g. 200gb, 512mb.
RECORDING_SIZE_LIMIT=0
STORAGE_SIZE_LIMIT=0

# LiveEdit's uncompressed edit-capture pipeline (see services/editCaptureService.js). At
# ~104MB/s sustained (uncompressed 1080p25 UYVY) this is ~375GB/hour — unlike RECORDING_SIZE_LIMIT
# above, do NOT leave this at 0/unlimited; pick a real cap that fits your disk budget.
EMERALD_EDIT_CAPTURE_PATH=I:\EmeraldDeltacast\Emerald\backend\EditCaptures
EDIT_CAPTURE_SIZE_LIMIT=500gb
EDIT_CAPTURE_PROXY_BITRATE_KBPS=4000
MEDIAMTX_PATH=I:\EmeraldDeltacast\MediaMtx\mediamtx.exe
MEDIAMTX_CONFIG_PATH=I:\EmeraldDeltacast\MediaMtx\mediamtx.yml
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WHEP_PORT=8889
MEDIAMTX_PUBLIC_HOST=127.0.0.1
DELTACAST_TX_SERVICE_URL=http://127.0.0.1:5055

# Timecode System generator (Timecode.Master.exe in Generator mode), which serves /api/timecode,
# /api/sync and /api/readers. The backend measures its clock offset against this every 2s and
# derives every displayed/stamped timecode from it. Point this at the Generator machine, not a
# Reader. Unreachable => fall back to the local wall clock, flagged as FREE_RUN.
EMERALD_TIMECODE_MASTER_URL=http://10.0.0.33:8888
# Optional: how this backend identifies itself in the generator's reader list. Defaults to
# emerald-backend-<hostname>.
# EMERALD_TIMECODE_READER_ID=emerald-backend

# Recording/segment/on-air history (db/), via TypeORM — separate from the unused DATABASE_URL
# Postgres pool above. DATABASE_TYPE is "sqlite" (default, zero-config — a single local file,
# nothing to install/run) or "mysql" (point at an existing server with the vars below).
DATABASE_TYPE=sqlite
DATABASE_PATH=I:\EmeraldDeltacast\Emerald\backend\data\emerald.sqlite
# Only used when DATABASE_TYPE=mysql:
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_USER=root
# DATABASE_PASSWORD=
# DATABASE_NAME=emerald
