EMERALD_RECORDINGS_PATH=I:\EmeraldDeltacast\Emerald\backend\Recordings
EMERALD_BACKUP_PATH=E:\Emerald
RECORDING_SIZE_LIMIT=200gb
STORAGE_SIZE_LIMIT=200gb
DELTACAST_TX_SERVICE_URL=http://127.0.0.1:5055

# LAN access: lets another machine on the same network load the Capture/Playback pages and see
# the live preview / on-air HLS playback. EMERALD_URLS/host binding is address-agnostic (0.0.0.0),
# but MEDIAMTX_PUBLIC_HOST must be this machine's actual LAN IP — it's baked into an absolute URL
# a remote browser dials directly for WebRTC/WHEP, so 0.0.0.0 won't work there. Update it if this
# machine's IP changes (e.g. DHCP reassignment).
EMERALD_URLS=http://0.0.0.0:5000
MEDIAMTX_PUBLIC_HOST=10.0.0.32